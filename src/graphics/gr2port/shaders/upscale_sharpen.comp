// The upscaler's picture into the antialias program's output, encoded to sRGB as in
// antialias_off.comp and sharpened there by the RCAS filter of AMD FidelityFX FSR 1 (MIT license),
// with its noise removal. It takes the antialias program's set.

#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D upscaled;
layout(set = 0, binding = 1) uniform sampler upscaled_sampler;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D picture;

layout(push_constant) uniform Constants {
    // From above 0 to 1, RCAS's strongest.
    float strength;
};

// The strongest negative lobe that keeps the filter's weights positive.
const float LobeLimit = 0.25 - 1.0 / 16.0;
// Keeps the limiters finite on a ring of pure black or white.
const float Smallest = 1.0 / 65536.0;

// The program's encoding: 12.92 x below 0.0031308, else 1.055 x^(1/2.4) - 0.055.
float Encode(float x) {
    const float curve = uintBitsToFloat(0x3f870a3du) *
                            exp2(uintBitsToFloat(0x3ed55555u) * log2(max(0.0, x))) +
                        uintBitsToFloat(0xbd6147aeu);
    return uintBitsToFloat(0x3b4d2e1cu) > x ? uintBitsToFloat(0x414eb852u) * x : curve;
}

vec3 Encoded(vec3 color) {
    return clamp(vec3(Encode(color.r), Encode(color.g), Encode(color.b)), 0.0, 1.0);
}

vec3 Neighbour(ivec2 pixel, ivec2 last) {
    return Encoded(
        texelFetch(sampler2D(upscaled, upscaled_sampler), clamp(pixel, ivec2(0), last), 0).rgb);
}

// Twice the luma, as RCAS weighs it.
float Luma(vec3 color) {
    return 0.5 * color.b + 0.5 * color.r + color.g;
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(picture);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    const ivec2 last = size - 1;
    const vec4 color = texelFetch(sampler2D(upscaled, upscaled_sampler), pixel, 0);
    const vec3 e = Encoded(color.rgb);
    const vec3 b = Neighbour(pixel + ivec2(0, -1), last);
    const vec3 d = Neighbour(pixel + ivec2(-1, 0), last);
    const vec3 f = Neighbour(pixel + ivec2(1, 0), last);
    const vec3 h = Neighbour(pixel + ivec2(0, 1), last);

    const float b_luma = Luma(b);
    const float d_luma = Luma(d);
    const float e_luma = Luma(e);
    const float f_luma = Luma(f);
    const float h_luma = Luma(h);
    const float high = max(max(max(b_luma, d_luma), e_luma), max(f_luma, h_luma));
    const float low = min(min(min(b_luma, d_luma), e_luma), min(f_luma, h_luma));
    const float noise =
        clamp(abs(0.25 * (b_luma + d_luma + f_luma + h_luma) - e_luma) / max(high - low, Smallest),
              0.0, 1.0);

    const vec3 ring_low = min(min(b, d), min(f, h));
    const vec3 ring_high = max(max(b, d), max(f, h));
    const vec3 hit_low = ring_low / max(4.0 * ring_high, vec3(Smallest));
    const vec3 hit_high = (1.0 - ring_high) / min(4.0 * ring_low - 4.0, vec3(-Smallest));
    const vec3 lobes = max(-hit_low, hit_high);
    const float lobe = max(-LobeLimit, min(max(lobes.r, max(lobes.g, lobes.b)), 0.0)) * strength *
                       (1.0 - 0.5 * noise);

    imageStore(picture, pixel, vec4((lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0), color.a));
}
