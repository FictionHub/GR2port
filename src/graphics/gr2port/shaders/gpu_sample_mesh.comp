// The game's sample mesh compute program 0x1c35394, one thread for a mesh that places particles on
// itself: when the effect object and its description sample a mesh, each particle the object
// places this frame takes a vertex of the mesh, picked in turn or by a hash of the particle, and
// moves by the vertex's position, scaled and turned by the mesh's matrix and the object's
// rotation; in mode 3 the vertex's normal, turned the same way, adds to its velocity. The object's
// count of particles to place goes back to 0. Words whose names the game does not give are named
// by what this program does with them.
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 1) in;

#include "gpu_sample.glsl"

// Row `row` of the mesh's matrix times a point scaled by `scale`, with 1 as its fourth component.
// The generated program, as the driver builds it, multiplies each matrix value by the scale before
// the point, which rounds apart from scaling the point first.
float ScaledPointRow(Words constants, uint row, vec3 scale, vec3 point) {
    const uint at = SampleMatrix + 4u * row;
    const vec4 m = uintBitsToFloat(uvec4(constants.words[at], constants.words[at + 1u],
                                         constants.words[at + 2u], constants.words[at + 3u]));
    return fma(m.z * scale.z, point.z,
               fma(m.y * scale.y, point.y, fma(m.x * scale.x, point.x, m.w)));
}

// Row `row` of the matrix's first three columns times a direction.
float MatrixDirectionRow(Words constants, uint row, vec3 direction) {
    const uint at = SampleMatrix + 4u * row;
    const vec3 m = uintBitsToFloat(uvec3(constants.words[at], constants.words[at + 1u],
                                         constants.words[at + 2u]));
    return fma(m.z, direction.z, fma(m.y, direction.y, m.x * direction.x));
}

void main() {
    Words constants = Words(constants_address);
    Words vertices = Words(vertices_address);
    const uint object = constants.words[SampleObject];
    if (Word(emitter_out_address, object, 128u, ObjectPlacing) != 1u) {
        return;
    }
    const uint description = Word(emitter_out_address, object, 128u, ObjectDescription);
    if (Word(description_address, description, 256u, DescriptionMesh) != 1u ||
        Word(description_address, description, 256u, DescriptionSamples) == 0u) {
        return;
    }
    const uint count = Word(emitter_out_address, object, 128u, ObjectCount);
    if (count == 0u) {
        return;
    }
    const uint pool = Word(description_address, description, 256u, DescriptionPool);
    const float divisor =
        Word(description_address, description, 256u, DescriptionOwnDivisor) != 2u
            ? float(pool)
            : Float(description_address, description, 256u, DescriptionDivisor);
    const float inverse_divisor = 1.0 / max(1.0, divisor);
    const bool in_turn = Word(description_address, description, 256u, DescriptionInTurn) > 0u;
    const bool unturned = Word(description_address, description, 256u, DescriptionFixed) == 1u;
    const vec3 position_scale =
        Vector(description_address, description, 256u, DescriptionPositionScale);
    const vec3 normal_scale =
        Vector(description_address, description, 256u, DescriptionNormalScale);
    const float last_vertex = float(constants.words[SampleVertices] - 1u);
    const float scale_start = Float(emitter_out_address, object, 128u, ObjectScaleStart);
    const float scale_range =
        Float(emitter_out_address, object, 128u, ObjectScaleEnd) - scale_start;
    const float duration = Float(emitter_out_address, object, 128u, ObjectDuration);
    const float inverse_duration = 1.0 / duration;
    const uint first = Word(emitter_out_address, object, 128u, ObjectFirst);
    uint cursor = Word(emitter_out_address, object, 128u, ObjectCursor);

    for (uint i = 0u; i < count; i++) {
        // Without the description's fixed word, the scale goes from its start to its end over the
        // placing's duration, back from the time it ends, and the object's rotation turns it.
        float scale = 1.0;
        vec4 rotation = vec4(0.0, 0.0, 0.0, 1.0);
        if (!unturned) {
            float time = 0.0;
            if (duration != 0.0) {
                time = fma(-float(i), inverse_duration,
                           Float(emitter_out_address, object, 128u, ObjectEnd));
            }
            scale = time * scale_range + scale_start;
            rotation = vec4(Vector(emitter_out_address, object, 128u, ObjectRotation),
                            Float(emitter_out_address, object, 128u, ObjectRotation + 12u));
        }
        const uint particle = first + cursor;
        // The program multiplies by the reciprocals, which spirv-opt would otherwise fold into
        // divisions that round apart.
        precise float along;
        if (in_turn) {
            along = float(cursor) * inverse_divisor;
        } else {
            const uint seed = 0xc6395u ^ Word(particle_out_address, particle, 64u, ParticleSeed);
            along = uintBitsToFloat(0x3ec01c14u) *
                    (uintBitsToFloat(0x402a91b9u) *
                     fract(abs(uintBitsToFloat(0x3ac01c14u) * float(seed))));
        }
        const uint offset = constants.words[SampleStride] * GameUint(last_vertex * along);
        cursor = GameRemainder(cursor + 1u, pool);

        if (constants.words[SampleMode] == ModeNormals) {
            const vec3 normal =
                normal_scale *
                VertexNormal(vertices.words[(constants.words[SampleNormal] + offset) >> 2]);
            const vec3 world = vec3(MatrixDirectionRow(constants, 0u, normal),
                                    MatrixDirectionRow(constants, 1u, normal),
                                    MatrixDirectionRow(constants, 2u, normal));
            const vec3 velocity = Vector(particle_out_address, particle, 64u, ParticleVelocity);
            SetVector(particle_out_address, particle, 64u, ParticleVelocity,
                      fma(Turned(rotation, world), vec3(scale), velocity));
        }
        const uint at = (constants.words[SamplePosition] + offset) >> 2;
        const vec3 vertex = uintBitsToFloat(
            uvec3(vertices.words[at], vertices.words[at + 1u], vertices.words[at + 2u]));
        const vec3 world = vec3(ScaledPointRow(constants, 0u, position_scale, vertex),
                                ScaledPointRow(constants, 1u, position_scale, vertex),
                                ScaledPointRow(constants, 2u, position_scale, vertex));
        const vec3 position = Vector(particle_out_address, particle, 64u, ParticlePosition);
        SetVector(particle_out_address, particle, 64u, ParticlePosition,
                  fma(vec3(scale), Turned(rotation, world), position));
    }
    Words(emitter_out_address).words[(object * 128u + ObjectCount) >> 2] = 0u;
}
