// The game's BackupColorBuffer (CS 0x1c23f08): copies the texel at each output pixel scaled by
// the source's size over the copy's.
#version 460
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform texture2D input_texture;
layout(set = 0, binding = 1) uniform sampler input_sampler;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D output_image;

// The copy's width and height, then the scale from its pixels to the source's.
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Size {
    vec4 size;
};
layout(push_constant) uniform Push {
    Size constants;
};

void main() {
    const ivec2 pixel = ivec2(gl_WorkGroupID.xy * 8u + gl_LocalInvocationID.xy);
    const vec4 size = constants.size;
    const ivec2 limit = ivec2(size.xy);
    if (pixel.y >= limit.y || pixel.x >= limit.x) {
        return;
    }
    const ivec2 source = ivec2(size.zw * vec2(pixel));
    imageStore(output_image, pixel,
               texelFetch(sampler2D(input_texture, input_sampler), source, 0));
}
