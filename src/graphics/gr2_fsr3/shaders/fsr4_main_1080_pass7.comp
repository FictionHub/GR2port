#version 460
#extension GL_NV_cooperative_vector : require
#extension GL_EXT_shader_explicit_arithmetic_types : require

// FSR 4 Lite's pass 7 for the 1080p size tier (fsr4_model_v07_fp8_no_scale_pass3 of
// fsr4_lite_main_1080_pass7.spv) with its matrix products on cooperative vectors, which NVIDIA
// GPUs run on their tensor cores. It reads and writes the bytes AMD's module does and its results
// are identical: the products are integer sums. One thread per quarter-resolution pixel.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 21) readonly buffer InitializerBuffer {
    uint init_words[];
};
layout(set = 0, binding = 141) buffer ScratchBuffer {
    uint scratch_words[];
};
layout(set = 0, binding = 256) uniform CsTensorSizes {
    uvec4 tensor_sizes[9];
};

// The tensors hold 16 one-byte channels per plane and have a one-pixel border.
const uint QuarterRow = 7712u;      // (480 + 2) * 16
const uint QuarterPlane = 2097664u; // 482 * 272 * 16
const uint HalfRow = 15392u;        // (960 + 2) * 16
const uint SkipBase = 8342464u;
const uint OutBase = 16684928u;

// A row-major copy of the 3x3 weights (16 rows of 144 bytes), which the upscaler appends to AMD's
// model data.
const uint MatrixA = 34048u;

const int RowMajor = gl_CooperativeVectorMatrixLayoutRowMajorNV;
const int Packed = gl_ComponentTypeSignedInt8PackedNV;
const int Int8 = gl_ComponentTypeSignedInt8NV;
const int Int32 = gl_ComponentTypeSignedInt32NV;

// Rounds acc / 2^shift half to even and saturates it to a signed byte.
int Requant(int acc, int shift) {
    return clamp((acc + ((1 << (shift - 1)) - 1) + ((acc >> shift) & 1)) >> shift, -128, 127);
}

uint Pack(ivec4 v) {
    return (uint(v.x) & 255u) | ((uint(v.y) & 255u) << 8) | ((uint(v.z) & 255u) << 16) |
           ((uint(v.w) & 255u) << 24);
}

ivec4 Unpack(uint w) {
    return ivec4(bitfieldExtract(int(w), 0, 8), bitfieldExtract(int(w), 8, 8),
                 bitfieldExtract(int(w), 16, 8), bitfieldExtract(int(w), 24, 8));
}

void main() {
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, uvec2(480u, 270u)))) {
        return;
    }

    // A 3x3 convolution of plane 0, 16 to 16 channels, as one product.
    uvec4 taps[9];
    for (uint ky = 0u; ky < 3u; ++ky) {
        for (uint kx = 0u; kx < 3u; ++kx) {
            const uint base = (16u * (p.x + kx) + QuarterRow * (p.y + ky)) >> 2;
            taps[3u * ky + kx] = uvec4(scratch_words[base], scratch_words[base + 1u],
                                       scratch_words[base + 2u], scratch_words[base + 3u]);
        }
    }
    const coopvecNV<uint32_t, 36> a_in = coopvecNV<uint32_t, 36>(
        taps[0], taps[1], taps[2], taps[3], taps[4], taps[5], taps[6], taps[7], taps[8]);
    coopvecNV<int32_t, 16> a;
    coopVecMatMulAddNV(a, a_in, Packed, init_words, MatrixA, Int8, init_words, 16256u, Int32, 16,
                       144, RowMajor, false, 144u);
    const uint center = (16u * (p.x + 1u) + QuarterRow * (p.y + 1u)) >> 2;
    uint l1[8];
    for (uint i = 0u; i < 4u; ++i) {
        l1[i] = Pack(ivec4(Requant(a[4u * i], 8), Requant(a[4u * i + 1u], 8),
                           Requant(a[4u * i + 2u], 8), Requant(a[4u * i + 3u], 8)));
        l1[4u + i] = scratch_words[center + (QuarterPlane >> 2) + i];
    }

    // A 1x1 convolution of that and plane 1, 32 to 64 channels, with ReLU.
    const coopvecNV<uint32_t, 8> c_in = coopvecNV<uint32_t, 8>(
        uvec4(l1[0], l1[1], l1[2], l1[3]), uvec4(l1[4], l1[5], l1[6], l1[7]));
    coopvecNV<int32_t, 64> c;
    coopVecMatMulAddNV(c, c_in, Packed, init_words, 16384u, Int8, init_words, 18432u, Int32, 64, 32,
                       RowMajor, false, 32u);
    uint h[16];
    for (uint i = 0u; i < 16u; ++i) {
        h[i] = Pack(ivec4(Requant(max(c[4u * i], 0), 7), Requant(max(c[4u * i + 1u], 0), 7),
                          Requant(max(c[4u * i + 2u], 0), 7), Requant(max(c[4u * i + 3u], 0), 7)));
    }

    // A 1x1 convolution, 64 to 32 channels, added to the input: plane 0, then plane 1 doubled.
    const coopvecNV<uint32_t, 16> e_in = coopvecNV<uint32_t, 16>(
        uvec4(h[0], h[1], h[2], h[3]), uvec4(h[4], h[5], h[6], h[7]),
        uvec4(h[8], h[9], h[10], h[11]), uvec4(h[12], h[13], h[14], h[15]));
    coopvecNV<int32_t, 32> e;
    coopVecMatMulAddNV(e, e_in, Packed, init_words, 18688u, Int8, init_words, 20736u, Int32, 32, 64,
                       RowMajor, false, 64u);
    uint r[8];
    for (uint i = 0u; i < 8u; ++i) {
        const ivec4 acc = ivec4(e[4u * i], e[4u * i + 1u], e[4u * i + 2u], e[4u * i + 3u]);
        const uint input_word = i < 4u ? scratch_words[center + i] : l1[i];
        const float scale = i < 4u ? 0.03125 : 0.0625;
        const vec4 f = vec4(Unpack(input_word)) * scale + vec4(acc) * (1.0 / 2048.0);
        r[i] = Pack(clamp(ivec4(roundEven(f * 32.0)), ivec4(-128), ivec4(127)));
    }

    // A 2x2 transposed convolution, 32 to 16 channels, added to the half-resolution skip tensor.
    // One product makes the 16 channels of all four output pixels, which share the biases.
    if (any(greaterThanEqual(p, tensor_sizes[4].xy))) {
        return;
    }
    const coopvecNV<uint32_t, 8> f_in =
        coopvecNV<uint32_t, 8>(uvec4(r[0], r[1], r[2], r[3]), uvec4(r[4], r[5], r[6], r[7]));
    coopvecNV<int32_t, 64> f;
    coopVecMatMulNV(f, f_in, Packed, init_words, 20864u, Int8, 64, 32, RowMajor, false, 32u);
    ivec4 bias[4];
    for (uint i = 0u; i < 4u; ++i) {
        const uint word = (22912u >> 2) + 4u * i;
        bias[i] = ivec4(init_words[word], init_words[word + 1u], init_words[word + 2u],
                        init_words[word + 3u]);
    }
    for (uint s = 0u; s < 4u; ++s) {
        const uvec2 o = 2u * p + uvec2(s % 2u, s / 2u);
        const uint pixel = (16u * (o.x + 1u) + HalfRow * (o.y + 1u)) >> 2;
        for (uint i = 0u; i < 4u; ++i) {
            const uint row = 16u * s + 4u * i;
            const ivec4 acc = ivec4(f[row], f[row + 1u], f[row + 2u], f[row + 3u]) + bias[i];
            const uint skip = scratch_words[pixel + (SkipBase >> 2) + i];
            const vec4 sum = vec4(Unpack(skip)) * 0.03125 + vec4(acc) * (1.0 / 8192.0);
            scratch_words[pixel + (OutBase >> 2) + i] =
                Pack(clamp(ivec4(roundEven(sum * 32.0)), ivec4(-128), ivec4(127)));
        }
    }
}
