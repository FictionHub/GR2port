#version 460
#extension GL_EXT_control_flow_attributes : require

// FSR 4 Lite's pass 7 for the 1080p size tier (fsr4_model_v07_fp8_no_scale_pass3 of
// fsr4_lite_main_1080_pass7.spv) for GPUs without 8-bit dot product instructions: each product of
// signed bytes is one float multiply-add. It reads and writes the bytes AMD's module does and its
// results are identical: every sum is an integer below 2^24, which floats hold exactly. One thread
// per quarter-resolution pixel.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 21) readonly buffer InitializerBuffer {
    float init_floats[];
};
layout(set = 0, binding = 141) buffer ScratchBuffer {
    uint scratch_words[];
};
layout(set = 0, binding = 256) uniform CsTensorSizes {
    uvec4 tensor_sizes[9];
};

// The tensors hold 16 one-byte channels per plane and have a one-pixel border.
const uint QuarterRow = 7712u;      // (480 + 2) * 16
const uint QuarterPlane = 2097664u; // 482 * 272 * 16
const uint HalfRow = 15392u;        // (960 + 2) * 16
const uint SkipBase = 8342464u;
const uint OutBase = 16684928u;

// The weights as floats, which the upscaler appends to AMD's model data. Each layer's weights are
// divided by the power of two its results are, and inputs read from the scratch buffer are
// offset by 128, which the biases take back.
const uint WeightsA = 13360u; // [tap][output][input], 9 x 16 x 16
const uint BiasA = WeightsA + 2304u;
const uint WeightsC = BiasA + 16u; // [output][input], 64 x 32
const uint BiasC = WeightsC + 2048u;
const uint WeightsE = BiasC + 64u; // [output][input], 32 x 64
const uint BiasE = WeightsE + 2048u;
const uint WeightsF = BiasE + 32u; // [output pixel][output][input], 4 x 16 x 32
const uint BiasF = WeightsF + 2048u;

// The 4 bytes of word, each plus 128.
vec4 Offset(uint word) {
    const uint w = word ^ 0x80808080u;
    return vec4(float(bitfieldExtract(w, 0, 8)), float(bitfieldExtract(w, 8, 8)),
                float(bitfieldExtract(w, 16, 8)), float(bitfieldExtract(w, 24, 8)));
}

uint Pack(vec4 v) {
    const ivec4 i = ivec4(v);
    return (uint(i.x) & 255u) | ((uint(i.y) & 255u) << 8) | ((uint(i.z) & 255u) << 16) |
           (uint(i.w) << 24);
}

void main() {
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, uvec2(480u, 270u)))) {
        return;
    }

    // A 3x3 convolution of plane 0, 16 to 16 channels.
    float a[16];
    [[unroll]] for (uint o = 0u; o < 16u; ++o) {
        a[o] = init_floats[BiasA + o];
    }
    [[dont_unroll]] for (uint tap = 0u; tap < 9u; ++tap) {
        const uint base = (16u * (p.x + tap % 3u) + QuarterRow * (p.y + tap / 3u)) >> 2;
        float x[16];
        [[unroll]] for (uint w = 0u; w < 4u; ++w) {
            const vec4 v = Offset(scratch_words[base + w]);
            x[4u * w] = v.x;
            x[4u * w + 1u] = v.y;
            x[4u * w + 2u] = v.z;
            x[4u * w + 3u] = v.w;
        }
        [[unroll]] for (uint o = 0u; o < 16u; ++o) {
            [[unroll]] for (uint i = 0u; i < 16u; ++i) {
                a[o] += x[i] * init_floats[WeightsA + 256u * tap + 16u * o + i];
            }
        }
    }
    const uint center = (16u * (p.x + 1u) + QuarterRow * (p.y + 1u)) >> 2;
    float l1[32];
    [[unroll]] for (uint o = 0u; o < 16u; ++o) {
        l1[o] = clamp(roundEven(a[o]), -128.0, 127.0);
    }
    [[unroll]] for (uint w = 0u; w < 4u; ++w) {
        const vec4 v = Offset(scratch_words[center + (QuarterPlane >> 2) + w]);
        l1[16u + 4u * w] = v.x;
        l1[16u + 4u * w + 1u] = v.y;
        l1[16u + 4u * w + 2u] = v.z;
        l1[16u + 4u * w + 3u] = v.w;
    }

    // A 1x1 convolution of that and plane 1, 32 to 64 channels, with ReLU, eight channels at a
    // time, each added to a 1x1 convolution, 64 to 32 channels, as it is made.
    float e[32];
    [[unroll]] for (uint o = 0u; o < 32u; ++o) {
        e[o] = init_floats[BiasE + o];
    }
    [[dont_unroll]] for (uint group = 0u; group < 64u; group += 8u) {
        float h[8];
        [[unroll]] for (uint o = 0u; o < 8u; ++o) {
            float c = init_floats[BiasC + group + o];
            [[unroll]] for (uint i = 0u; i < 32u; ++i) {
                c += l1[i] * init_floats[WeightsC + 32u * (group + o) + i];
            }
            h[o] = clamp(roundEven(c), 0.0, 127.0);
        }
        [[unroll]] for (uint o = 0u; o < 32u; ++o) {
            [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                e[o] += h[i] * init_floats[WeightsE + 64u * o + group + i];
            }
        }
    }

    // Added to the input: plane 0, then plane 1 doubled.
    float r[32];
    [[unroll]] for (uint w = 0u; w < 8u; ++w) {
        const vec4 in_bytes = w < 4u ? Offset(scratch_words[center + w])
                                     : 2.0 * vec4(l1[4u * w], l1[4u * w + 1u], l1[4u * w + 2u],
                                                  l1[4u * w + 3u]);
        const vec4 sum =
            in_bytes + vec4(e[4u * w], e[4u * w + 1u], e[4u * w + 2u], e[4u * w + 3u]);
        const vec4 v = clamp(roundEven(sum), -128.0, 127.0);
        r[4u * w] = v.x;
        r[4u * w + 1u] = v.y;
        r[4u * w + 2u] = v.z;
        r[4u * w + 3u] = v.w;
    }

    // A 2x2 transposed convolution, 32 to 16 channels, added to the half-resolution skip tensor.
    if (any(greaterThanEqual(p, tensor_sizes[4].xy))) {
        return;
    }
    [[dont_unroll]] for (uint s = 0u; s < 4u; ++s) {
        float f[16];
        [[unroll]] for (uint o = 0u; o < 16u; ++o) {
            f[o] = init_floats[BiasF + o];
            [[unroll]] for (uint i = 0u; i < 32u; ++i) {
                f[o] += r[i] * init_floats[WeightsF + 512u * s + 32u * o + i];
            }
        }
        const uvec2 o = 2u * p + uvec2(s % 2u, s / 2u);
        const uint pixel = (16u * (o.x + 1u) + HalfRow * (o.y + 1u)) >> 2;
        [[unroll]] for (uint w = 0u; w < 4u; ++w) {
            const vec4 sum = Offset(scratch_words[pixel + (SkipBase >> 2) + w]) +
                             vec4(f[4u * w], f[4u * w + 1u], f[4u * w + 2u], f[4u * w + 3u]);
            scratch_words[pixel + (OutBase >> 2) + w] = Pack(clamp(roundEven(sum), -128.0, 127.0));
        }
    }
}
