#version 460
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_EXT_spirv_intrinsics : require

// FSR 4 Lite's pass 9 for the 1080p size tier (fsr4_model_v07_fp8_no_scale_postpass of
// fsr4_lite_main_1080_pass9.spv). AMD's module takes the log of an input colour texel in each of
// a thread's four 3x3 filters that read it; this one takes it once, and reads the weights AMD's
// module holds as constants from AMD's model data, which has the same bytes. The rest is AMD's
// operations in AMD's order, so its results are identical. Built with SRGB, it writes the output
// colour as the picture's encode pass does: the 16-bit floats of AMD's output, encoded to sRGB in
// an R8G8B8A8_UNORM image. One thread per half-resolution pixel makes its four pixels.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 3) uniform texture2D r_input_color;
layout(set = 0, binding = 6) uniform texture2D r_input_exposure;
layout(set = 0, binding = 9) uniform texture2D r_reprojected_color;
layout(set = 0, binding = 21) readonly buffer InitializerBuffer {
    int init_words[];
};
layout(set = 0, binding = 129) uniform writeonly image2D rw_history_color;
#ifdef SRGB
layout(set = 0, binding = 130, rgba8) uniform writeonly image2D rw_mlsr_output_color;
#else
layout(set = 0, binding = 130) uniform writeonly image2D rw_mlsr_output_color;
#endif
layout(set = 0, binding = 134, rgba8) uniform writeonly image2D rw_recurrent_0;
layout(set = 0, binding = 137, r32f) uniform writeonly image2D rw_auto_exposure_texture;
layout(set = 0, binding = 141) readonly buffer ScratchBuffer {
    int scratch_words[];
};
layout(set = 0, binding = 257, std140) uniform MLSR_Optimized_Constants {
    vec2 inv_size;
    vec2 scale;
    vec2 inv_scale;
    vec2 jitter;
    vec2 mv_scale;
    vec2 tex_size;
    vec2 max_render_size;
    vec2 motion_vector_jitter_cancellation;
    uint width;
    uint height;
    uint reset;
    uint width_lr;
    uint height_lr;
    float pre_exposure;
    float previous_pre_exposure;
    uint rcas_enabled;
    float rcas_sharpness;
    float pad;
};

// GLSL's max is FMax, whose result is undefined for NaN; AMD's module uses NMax.
spirv_instruction(set = "GLSL.std.450", id = 80) vec3 NMax(vec3 x, vec3 y);

// The tensor holds 16 one-byte channels and has a one-pixel border.
const uint HalfRow = 15392u; // (960 + 2) * 16
const uint InBase = 16684928u;

// Words of AMD's model data: four signed bytes of weights, or a 32-bit bias.
const uint WeightsA = 5760u; // [tap][output][input], 9 x 16 x 16
const uint BiasA = 6336u;
const uint WeightsB = 6368u; // [output][input], 32 x 16
const uint BiasB = 6496u;
const uint WeightsC = 6528u; // [output][input], 16 x 32
const uint BiasC = 6656u;
const uint WeightsPixel = 6688u; // [output pixel][kernel, then state][output][input]
const uint BiasPixel = 6816u; // [kernel, then state][output]

#ifdef SRGB
// The encode pass's sRGB: 12.92 x below 0.0031308, else 1.055 x^(1/2.4) - 0.055.
float Encode(float x) {
    const float curve = uintBitsToFloat(0x3f870a3du) *
                            exp2(uintBitsToFloat(0x3ed55555u) * log2(max(0.0, x))) +
                        uintBitsToFloat(0xbd6147aeu);
    return uintBitsToFloat(0x3b4d2e1cu) > x ? uintBitsToFloat(0x414eb852u) * x : curve;
}
#endif

// A sum divided by 256 to a signed byte, halves to even, as AMD's module rounds it.
int Byte(int sum) {
    return clamp(((sum + 127) + ((sum >> 8) & 1)) >> 8, -128, 127);
}

int Pack(ivec4 bytes) {
    return int((((uint(bytes.x) & 255u) | ((uint(bytes.y) & 255u) << 8)) |
                ((uint(bytes.z) & 255u) << 16)) |
               ((uint(bytes.w) & 255u) << 24));
}

// The log of the input colour at a texel, clamped to the render size.
vec3 Logged(ivec2 at, float exposure) {
    const ivec2 last = ivec2(uvec2(width_lr, height_lr) - 1u);
    const vec3 rgb = texelFetch(r_input_color, clamp(at, ivec2(0), last), 0).rgb;
    return NMax(log(vec3(1.0) + (rgb * exposure) * 150.0) * 0.117399998, vec3(0.0));
}

void main() {
    const uint lid = gl_LocalInvocationID.x;
    if (all(equal(gl_GlobalInvocationID.xy, uvec2(0u)))) {
        const float exposure = texelFetch(r_input_exposure, ivec2(0), 0).x;
        imageStore(rw_auto_exposure_texture, ivec2(1, 0), vec4(exposure == 0.0 ? 1.0 : exposure));
    }
    const uvec2 half_size = uvec2(ivec2(int(width), int(height)) / 2);
    const uint quad = lid >> 2;
    const uvec2 pos =
        uvec2(((quad % 8u) << 1) | (lid & 1u), ((quad / 8u) << 1) | ((lid & 3u) >> 1)) +
        gl_WorkGroupID.xy * 16u;
    if (any(greaterThanEqual(pos, half_size))) {
        return;
    }

    // A 3x3 convolution, 16 to 16 channels; taps outside the picture are zero.
    int x[36];
    [[unroll]] for (uint tap = 0u; tap < 9u; ++tap) {
        const ivec2 t = ivec2(pos) - 1 + ivec2(tap % 3u, tap / 3u);
        const bool inside =
            all(greaterThanEqual(t, ivec2(0))) && all(lessThan(uvec2(t), half_size));
        const uint base = (InBase + 16u * uint(t.x + 1) + HalfRow * uint(t.y + 1)) >> 2;
        [[unroll]] for (uint w = 0u; w < 4u; ++w) {
            x[4u * tap + w] = inside ? scratch_words[base + w] : 0;
        }
    }
    int a[16];
    [[unroll]] for (uint o = 0u; o < 16u; ++o) {
        a[o] = init_words[BiasA + o];
    }
    [[unroll]] for (uint tap = 0u; tap < 9u; ++tap) {
        [[unroll]] for (uint o = 0u; o < 16u; ++o) {
            const uint row = WeightsA + 64u * tap + 4u * o;
            [[unroll]] for (uint w = 0u; w < 4u; ++w) {
                a[o] += dotPacked4x8EXT(x[4u * tap + w], init_words[row + w]);
            }
        }
    }
    int l1[4];
    [[unroll]] for (uint g = 0u; g < 4u; ++g) {
        l1[g] = Pack(ivec4(Byte(a[4u * g]), Byte(a[4u * g + 1u]), Byte(a[4u * g + 2u]),
                           Byte(a[4u * g + 3u])));
    }

    // A 1x1 convolution, 16 to 32 channels, with ReLU.
    int h[8];
    [[unroll]] for (uint g = 0u; g < 8u; ++g) {
        ivec4 bytes;
        [[unroll]] for (uint k = 0u; k < 4u; ++k) {
            const uint o = 4u * g + k;
            int sum = init_words[BiasB + o];
            [[unroll]] for (uint i = 0u; i < 4u; ++i) {
                sum += dotPacked4x8EXT(l1[i], init_words[WeightsB + 4u * o + i]);
            }
            bytes[k] = Byte(max(sum, 0));
        }
        h[g] = Pack(bytes);
    }

    // A 1x1 convolution, 32 to 16 channels, added to the input at half weight.
    const uint center = (InBase + 16u * (pos.x + 1u) + HalfRow * (pos.y + 1u)) >> 2;
    int r[4];
    [[unroll]] for (uint g = 0u; g < 4u; ++g) {
        const int added = scratch_words[center + g];
        ivec4 bytes;
        [[unroll]] for (uint k = 0u; k < 4u; ++k) {
            const uint o = 4u * g + k;
            int sum = init_words[BiasC + o];
            [[unroll]] for (uint i = 0u; i < 8u; ++i) {
                sum += dotPacked4x8EXT(h[i], init_words[WeightsC + 8u * o + i]);
            }
            const float residual = float(bitfieldExtract(added, int(8u * k), 8)) * 0.03125;
            bytes[k] = clamp(int(roundEven((residual + float(sum) * 0.0009765625) * 16.0)), -128,
                             127);
        }
        r[g] = Pack(bytes);
    }

    float exposure = texelFetch(r_input_exposure, ivec2(0), 0).x;
    if (exposure == 0.0) {
        exposure = 1.0;
    }
    exposure = exposure / pre_exposure;

    // Each pixel filters the input colour at the 3x3 texels around its nearest. When the render
    // size is below the output size, the other pixels' nearest texels are at most one right of and
    // below the first pixel's, and the four filters read a 4x4 block, whose logs are taken once in
    // 32-wide subgroups. In 64-wide ones the block's registers cost more than the logs.
    vec2 centers[4];
    uvec2 nearest[4];
    [[unroll]] for (uint s = 0u; s < 4u; ++s) {
        const uvec2 o = 2u * pos + uvec2(s % 2u, s / 2u);
        centers[s] = ((vec2(-0.5) + inv_scale * vec2(0.5)) + vec2(o) * inv_scale) + jitter;
        nearest[s] = uvec2(ivec2(roundEven(centers[s])));
    }
    const uvec2 step = nearest[3] - nearest[0];
    const bool blocked = gl_SubgroupSize == 32u && all(lessThanEqual(step, uvec2(1u)));
    vec3 block[16];
    if (blocked) {
        [[unroll]] for (uint i = 0u; i < 16u; ++i) {
            block[i] = Logged(ivec2(nearest[0] - 1u + uvec2(i % 4u, i / 4u)), exposure);
        }
    }

    // Each of the four pixels: a 1x1 convolution, 16 to 4 channels, for the shape of the 3x3
    // filter and its blend with the reprojected colour, and another for the recurrent state.
    [[unroll]] for (uint s = 0u; s < 4u; ++s) {
        ivec4 kernel_sum;
        ivec4 state_sum;
        [[unroll]] for (uint k = 0u; k < 4u; ++k) {
            const uint row = WeightsPixel + 32u * s + 4u * k;
            kernel_sum[k] = init_words[BiasPixel + k];
            state_sum[k] = init_words[BiasPixel + 4u + k];
            [[unroll]] for (uint i = 0u; i < 4u; ++i) {
                kernel_sum[k] += dotPacked4x8EXT(r[i], init_words[row + i]);
                state_sum[k] += dotPacked4x8EXT(r[i], init_words[row + 16u + i]);
            }
        }
        const vec4 kernel = vec4(kernel_sum) * 0.0009765625;
        const vec4 recurrent = vec4(1.0) / (vec4(1.0) + exp(-(vec4(state_sum) * 0.0009765625)));
        const uvec2 o = 2u * pos + uvec2(s % 2u, s / 2u);

        // The logs of the pixel's 3x3 texels, row by row.
        vec3 taps[9];
        if (blocked) {
            const bool right = s % 2u == 1u && step.x == 1u;
            const bool below = s / 2u == 1u && step.y == 1u;
            [[unroll]] for (uint tap = 0u; tap < 9u; ++tap) {
                const uint at = 4u * (tap / 3u) + tap % 3u;
                const vec3 row = right ? block[at + 1u] : block[at];
                const vec3 next_row = right ? block[at + 5u] : block[at + 4u];
                taps[tap] = below ? next_row : row;
            }
        } else {
            [[unroll]] for (uint tap = 0u; tap < 9u; ++tap) {
                taps[tap] =
                    Logged(ivec2(nearest[s] - 1u + uvec2(tap % 3u, tap / 3u)), exposure);
            }
        }

        const float ex = exp(kernel.x);
        const float enx = exp(-kernel.x);
        const float tilt = (ex - enx) / (ex + enx);
        const float sx = 2.0 / (1.0 + exp(-kernel.y));
        const float sy = 2.0 / (1.0 + exp(-kernel.z));
        const float sxx = sx * sx;
        const float syy = sy * sy;
        const float sxy = sx * sy;
        const vec2 c = centers[s];
        const uint cx = nearest[s].x;
        const uint cy = nearest[s].y;
        const float y0 = (float(cy - 1u) - c.y) * scale.y;
        const float yy0 = y0 * y0;
        const float x0 = (float(cx - 1u) - c.x) * scale.x;
        const float xx0 = (x0 * x0) * sxx;
        const float tilt2 = 2.0 * tilt;
        const float yyw0 = yy0 * syy;
        const float w0 = exp(-2.26346755 * ((xx0 + ((tilt2 * (x0 * y0)) * sxy)) + yyw0));
        vec3 sum = taps[0] * w0;
        const float x1 = (float(cx) - c.x) * scale.x;
        const float xx1 = (x1 * x1) * sxx;
        const float w1 = exp(-2.26346755 * ((xx1 + ((tilt2 * (x1 * y0)) * sxy)) + yyw0));
        float weights = w0 + w1;
        sum = sum + taps[1] * w1;
        const float x2 = (float(cx + 1u) - c.x) * scale.x;
        const float xx2 = (x2 * x2) * sxx;
        const float w2 = exp(-2.26346755 * ((xx2 + ((tilt2 * (x2 * y0)) * sxy)) + yyw0));
        weights = weights + w2;
        sum = sum + taps[2] * w2;
        const float y1 = (float(cy) - c.y) * scale.y;
        const float yyw1 = (y1 * y1) * syy;
        const float w3 = exp(-2.26346755 * ((xx0 + ((tilt2 * (x0 * y1)) * sxy)) + yyw1));
        weights = weights + w3;
        sum = sum + taps[3] * w3;
        const float w4 = exp(-2.26346755 * ((xx1 + ((tilt2 * (x1 * y1)) * sxy)) + yyw1));
        weights = weights + w4;
        sum = sum + taps[4] * w4;
        const float w5 = exp(-2.26346755 * ((xx2 + ((tilt2 * (x2 * y1)) * sxy)) + yyw1));
        weights = weights + w5;
        sum = sum + taps[5] * w5;
        const float y2 = (float(cy + 1u) - c.y) * scale.y;
        const float yyw2 = (y2 * y2) * syy;
        const float w6 = exp(-2.26346755 * ((xx0 + ((tilt2 * (x0 * y2)) * sxy)) + yyw2));
        weights = weights + w6;
        sum = sum + taps[6] * w6;
        const float w7 = exp(-2.26346755 * ((xx1 + ((tilt2 * (x1 * y2)) * sxy)) + yyw2));
        weights = weights + w7;
        sum = sum + taps[7] * w7;
        const float w8 = exp(-2.26346755 * ((xx2 + ((tilt2 * (x2 * y2)) * sxy)) + yyw2));
        weights = weights + w8;
        sum = sum + taps[8] * w8;
        const vec3 filtered = sum / vec3(weights);
        const float blend = 1.0 / (1.0 + exp(-kernel.w));
        const vec3 history = filtered * (1.0 - blend) +
                             texelFetch(r_reprojected_color, ivec2(o), 0).rgb * blend;
        vec3 color = history;
        if (rcas_enabled == 0u) {
            color = NMax((exp(history * 8.51788044) - vec3(1.0)) * vec3(0.00666666683), vec3(0.0)) /
                    vec3(exposure);
        }
        imageStore(rw_recurrent_0, ivec2(o), recurrent);
        imageStore(rw_history_color, ivec2(o), vec4(history, 0.0));
        const vec3 output_color = clamp(color, vec3(0.0), vec3(64000.0));
#ifdef SRGB
        const vec2 rg = unpackHalf2x16(packHalf2x16(output_color.rg));
        const float b = unpackHalf2x16(packHalf2x16(vec2(output_color.b, 0.0))).x;
        imageStore(rw_mlsr_output_color, ivec2(o),
                   vec4(Encode(rg.x), Encode(rg.y), Encode(b), 0.0));
#else
        imageStore(rw_mlsr_output_color, ivec2(o), vec4(output_color, 0.0));
#endif
    }
}
